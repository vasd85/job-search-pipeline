#!/bin/sh
# Installed with pre-push by setup:machine. Use the tool beside this installed hook,
# while formatting the committing repository's active index (including pathspec commits).
formatter="$(dirname "$0")/../format-staged.mjs"
if [ ! -f "$formatter" ]; then
  echo "pre-commit: staged formatter is missing; nothing was committed." >&2
  exit 1
fi
if ! node "$formatter"; then
  exit 1
fi
if ! git diff --cached --check; then
  echo "pre-commit: whitespace errors in the staged changes (listed above); nothing was committed." >&2
  exit 1
fi
