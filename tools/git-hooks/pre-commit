#!/bin/sh
# The engine's pre-commit hook, installed by the same absolute core.hooksPath as pre-push
# (tools/setup/README.md). It refuses a commit whose staged content has a whitespace error — the
# defects the format stage of `npm run ci` rejects once committed. It reads the index git hands it,
# so `git commit -- <paths>` is checked on what it commits, not on the working tree.
if ! git diff --cached --check; then
  echo "pre-commit: whitespace errors in the staged changes (listed above); nothing was committed." >&2
  exit 1
fi
